{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(**)",
      "Write(**)",
      "Edit(*)",
      "MultiEdit(*)",
      "WebFetch(*)"
    ],
    "ask":[
      "Bash(prisma *)",
      "Bash(npx prisma *)",
      "Bash(yarn prisma *)",
      "Bash(pnpm prisma *)",
      "Edit(**/prisma/schema.prisma)",
      "Edit(**/migrations/**)",
      "Write(**/prisma/schema.prisma)",
      "Write(**/migrations/**)",
      "Bash(psql *)",
      "Bash(mysql *)",
      "Bash(sqlite3 *)",
      "Bash(mongosh *)",
      "Bash(mongodump *)",
      "Bash(mongorestore *)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push --force-reset*)",
      "Bash(npx prisma db push --accept-data-loss*)"
    ]
  }
}
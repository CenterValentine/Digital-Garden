dist
# dist/ is build output EXCEPT this one file, which is a committed artifact that
# app/globals.css imports directly (`@import "../dist/variables.css"`). It is not
# regenerated by `pnpm build:tokens` — style-dictionary.config.js points at a
# stale source path (lib/design-system/... instead of lib/design/system/...), so
# the task is a silent no-op. Until that config is fixed, this file must reach
# the build context or the Next build fails on an unresolvable CSS import.
!dist/variables.css
node_modules
out

